# ── OBBLIGATORIO ──────────────────────────────────────────────────────────────
# API Key Anthropic (da console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pubblica dell'app su Vercel (senza slash finale)
NEXT_PUBLIC_APP_URL=https://rv-capital-alpha.vercel.app

# ── eToro API (Per sincronizzazione Read-Only del portafoglio) ────────────────
# Ottenibili da: Impostazioni > Trading > Gestione Chiavi API su etoro.com
ETORO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ETORO_USER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── VERCEL KV (Redis per storage persistente) ─────────────────────────────────
# Si configura automaticamente collegando Vercel KV nel dashboard
# oppure crea manualmente su upstash.com (free tier)
KV_REST_API_URL=https://xxxxxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SICUREZZA CRON ────────────────────────────────────────────────────────────
# Stringa casuale lunga - usata per proteggere il cron endpoint
CRON_SECRET=genera_una_stringa_random_lunga_qui
